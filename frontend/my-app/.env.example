# 실제 백엔드에 붙일 때만 필요하다. 비워두면(둘 다 없으면) 앱은 목데이터(src/api/mock)로 동작한다.
# 이 파일을 .env.local로 복사해서 값을 채운다 — .env.local은 .gitignore(*.local)에 걸려 커밋되지 않는다.

# 백엔드 API 서버 주소. "/api" prefix는 코드에서 자동으로 붙으므로 origin까지만 적는다.
VITE_BATON_API_BASE_URL=

# 데모용 단일 사용자의 API Key. 로그인/회원가입 화면이 스코프 밖이라 프론트에 가입 폼이
# 없다 — 백엔드 팀이 POST /api/users로 데모 계정을 한 번 만들어 응답의 api_key를 여기에
# 넣어주면 된다. 자세한 내용은 docs/api-integration.md 참고.
VITE_BATON_API_KEY=
